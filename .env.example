
# ==============================================================================
# HiDevs RAG Chatbot - Environment Configuration Template
# ==============================================================================

# Application Settings
APP_NAME=HiDevs_RAG_Chatbot
ENVIRONMENT=development
LOG_LEVEL=INFO

# Knowledge Base
KNOWLEDGE_BASE_PATH=data/knowledge_base.txt

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEMPERATURE=0.0

# Qdrant Vector Database
# Full hosted Qdrant URL (e.g. https://xyz.cloud.qdrant.io:6333). Leave empty to use local host/port below.
QDRANT_URL=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=hidevs_knowledge_base
QDRANT_API_KEY=

# Embedding Configuration
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSION=3072

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5

# API (FastAPI) - comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_FILE=logs/app.log
